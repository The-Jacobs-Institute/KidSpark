# Runtime configuration only; never put real credentials in this tracked file.
GCP_PROJECT_ID=kidspark-499901
GCP_REGION=us-central1
VERTEX_GENERATION_LOCATION=global
VERTEX_EMBEDDING_LOCATION=us-central1
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072
# Local SQLite is isolated from the reference corpus. Use PostgreSQL in Cloud Run.
KIDSPARK_APP_DATABASE_URL=sqlite:///work/kidspark.sqlite
# Existing corpus connection, supplied through Secret Manager in Cloud Run.
POSTGRESQL_DATABASE_URL=
HYPER3D_API_KEY=
KIDSPARK_ARTIFACT_BUCKET=
KIDSPARK_WORKER_MODE=local
KIDSPARK_MAX_RUNNING_JOBS=2
KIDSPARK_MAX_PENDING_JOBS=20
KIDSPARK_MAX_JOB_ATTEMPTS=3
KIDSPARK_JOB_LEASE_SECONDS=180
# Cloud only: projects/kidspark-499901/locations/us-central1/jobs/<new-worker-name>
KIDSPARK_WORKER_JOB=
KIDSPARK_RAG_ENABLED=true
KIDSPARK_COOKIE_SECURE=false
